# Copy this file to .env and fill it in, or just set these in the app's
# Credentials menu — the app writes the same file.
# .env is gitignored: never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# The host your Costpoint Time & Expense runs on.
COSTPOINT_HOST=yourcompany-cp.costpointfoundations.com

# Your Deltek Costpoint organisation code (all caps, e.g. ACMECORPLLC).
COSTPOINT_ORGANIZATION=

# Your Costpoint login username (e.g. 12345.J.DOE).
COSTPOINT_USERNAME=

# Your Costpoint password.
COSTPOINT_PASSWORD=

# ── MFA — only if your account requires a second factor ───────────────────────
# For interactive (terminal) runs you are prompted at runtime, so these are only
# needed for unattended / scheduled runs.
#
# IMPORTANT: a time-limited one-time passcode cannot be stored as a static
# secret. If your scheduled account requires MFA, use an MFA-exempt service
# account instead.
#
# COSTPOINT_MFA_CODE=
# COSTPOINT_MFA_PIN=      # only if your MFA method also requires a PIN
